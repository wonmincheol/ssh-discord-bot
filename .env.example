# Copy this file to .env and replace the example values.
# Never commit the resulting .env file.

# Discord bot core (required)
DISCORD_TOKEN=replace-with-your-discord-bot-token

# Comma-separated optional extensions
BOT_EXTENSIONS=extensions.system,extensions.palworld

# Mini PC / Wake on LAN
WOL_BROADCAST_ADDRESS=172.30.1.255
WOL_MAC_ADDRESS=00:00:00:00:00:00

# Palworld extension
PALWORLD_API_URL=http://127.0.0.1:8212
PALWORLD_API_USER=admin
PALWORLD_API_PASSWORD=replace-with-your-palworld-admin-password
PALWORLD_SCRIPT_PATH=/data/ssh-discord-bot/extensions/palworld/server-control
PALWORLD_AUTO_SHUTDOWN_ENABLED=true
PALWORLD_AUTO_SHUTDOWN_SECONDS=3600
PALWORLD_CHECK_INTERVAL=60
PALWORLD_COMMAND_TIMEOUT=30
